{
  "description": "claude-mem-go hooks",
  "hooks": {
    "Setup": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/scripts/ensure-binary.sh\"",
            "timeout": 300
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/scripts/run-hook.sh\" start",
            "timeout": 15
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/scripts/run-hook.sh\" context",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/scripts/run-hook.sh\" prompt-context",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/scripts/run-hook.sh\" file-context",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/scripts/run-hook.sh\" hook",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/scripts/run-hook.sh\" stop",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ]
  }
}
